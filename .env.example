# Per-post OG image signing secret (nuxt-og-image)
NUXT_OG_IMAGE_SECRET=

# Buttondown account handle for newsletter embed form (phase 005)
# Leave empty to render the "Newsletter signup coming soon" placeholder.
BUTTONDOWN_USERNAME=

# Umami Cloud website ID for privacy-respecting analytics (phase 006).
# Leave empty to disable analytics entirely.
UMAMI_WEBSITE_ID=660709e9-04d6-4bb3-ae75-dc0937220012
